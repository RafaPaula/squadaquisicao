# --- Banco de dados ---
DATABASE_URL=postgresql+psycopg2://at_user:at_password@localhost:5432/talent_db

# --- inHire API ---
# Conta de servico criada em Settings > API Users > Add User na inHire.
INHIRE_AUTH_BASE_URL=https://auth.inhire.app
INHIRE_API_BASE_URL=https://api.inhire.app
INHIRE_EMAIL=changeme
INHIRE_PASSWORD=changeme
# Identificador de tenant da conta, enviado no header X-Tenant em toda
# chamada (login + api). Ex.: "acme-corp".
INHIRE_TENANT=changeme
INHIRE_LOGIN_ENDPOINT=/login
INHIRE_JOBS_ENDPOINT=/jobs/paginated/lean

# --- Azure DevOps (fase futura) ---
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/sua-org
AZURE_DEVOPS_PROJECT=SeuProjeto
AZURE_DEVOPS_PAT=changeme

# --- Armazenamento de arquivos de currículo ---
# local | azure_blob
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/resumes
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=resumes

# --- App ---
APP_ENV=development
