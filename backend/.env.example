# Copie para .env e preencha com valores reais (nunca comitar o .env).

DATABASE_URL=sqlite:///./talent_mirror.db

INHIRE_AUTH_BASE_URL=https://auth.inhire.app
INHIRE_API_BASE_URL=https://api.inhire.app
INHIRE_EMAIL=
INHIRE_PASSWORD=
INHIRE_TENANT=
INHIRE_LOGIN_ENDPOINT=/login
INHIRE_JOBS_ENDPOINT=/jobs/paginated/lean

AZURE_DEVOPS_ORG_URL=https://db1global.visualstudio.com
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_TEAM=
AZURE_DEVOPS_PAT=

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/resumes
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=resumes

# Origens liberadas no CORS (separadas por virgula). Em producao, o
# dominio do frontend publicado (ex.: https://talent-mirror.vercel.app).
CORS_ORIGINS=http://localhost:5173

# Senha compartilhada temporaria (gate de acesso) enquanto o SSO real via
# Entra ID nao sai do papel. Vazio = sem gate (uso local).
APP_ACCESS_PASSWORD=

APP_ENV=development
